{
  "name": "moana-multi-account-technical-poc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test:unopened": "node scripts/test-unopened-backup.mjs",
    "test:ui": "vitest run src/AccountingApp.test.tsx src/AttachmentFlow.test.tsx --environment jsdom",
    "test": "npm run test:ui && node scripts/test-ledger-format.mjs && node scripts/test-accounting.mjs && node scripts/test-stage5.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "30.1.0",
    "vitest": "5.0.1"
  }
}
